package gcp

import (
	"context"
	"errors"
	"os"
	"slices"
	"sync"
	"time"

	"github.com/kubeneuron/kubeneuron/test/replacement/restartsim"
)

// The kind controller reads inventory concurrently with replacement operations.
type rehearsalClient struct {
	mu        sync.Mutex
	fixture   *fakeGKE
	firstNode string
	path      string
	snapshot  resizeSnapshot
}

// resizeSnapshot is the simulated pool on the rehearsal volume: a restarted
// controller finds the deletes and resizes the one before it made.
type resizeSnapshot struct {
	// Calls are the resizes that set the pool back after a remove-first
	// delete.
	Calls      int             `json:"resize_calls"`
	Groups     []snapshotGroup `json:"groups"`
	Ops        []operation     `json:"ops"`
	Deleted    []string        `json:"deleted"`
	RequestIDs map[string]bool `json:"request_ids"`
}

type snapshotGroup struct {
	Target  int32    `json:"target"`
	Members []member `json:"members"`
	Next    int      `json:"next"`
}

func newSDKAPI(_ context.Context, _ settings) (gkeAPI, error) {
	f := newFakeGKE(1)
	c := &rehearsalClient{fixture: f, firstNode: os.Getenv("REHEARSAL_FIRST_NODE"), path: os.Getenv("REHEARSAL_DELETE_SNAPSHOT")}
	found := false
	if c.path != "" {
		var err error
		if found, err = restartsim.Load(c.path, &c.snapshot); err != nil {
			return nil, err
		}
	}
	if !found {
		if c.firstNode != "" {
			f.groups[0].members[0].Name = c.firstNode
		}
		return c, nil
	}
	if len(c.snapshot.Groups) != len(f.groups) {
		return nil, errors.New("incomplete simulated GKE snapshot")
	}
	for i, g := range c.snapshot.Groups {
		f.groups[i].target, f.groups[i].members, f.groups[i].next = g.Target, g.Members, g.Next
	}
	f.ops, f.deleted, f.requestIDs = c.snapshot.Ops, c.snapshot.Deleted, c.snapshot.RequestIDs
	return c, nil
}

// save keeps the simulated pool after a change, before its answer.
func (c *rehearsalClient) save() error {
	if c.path == "" {
		return nil
	}
	f := c.fixture
	c.snapshot.Groups = c.snapshot.Groups[:0]
	for _, g := range f.groups {
		c.snapshot.Groups = append(c.snapshot.Groups, snapshotGroup{Target: g.target, Members: slices.Clone(g.members), Next: g.next})
	}
	c.snapshot.Ops, c.snapshot.Deleted, c.snapshot.RequestIDs = slices.Clone(f.ops), slices.Clone(f.deleted), f.requestIDs
	return restartsim.Save(c.path, c.snapshot)
}

func (c *rehearsalClient) Cluster(ctx context.Context) (cluster, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.fixture.Cluster(ctx)
}

func (c *rehearsalClient) Instance(ctx context.Context, in instance) (vm, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.fixture.Instance(ctx, in)
}

func (c *rehearsalClient) Group(ctx context.Context, g groupRef) (group, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.fixture.Group(ctx, g)
}

func (c *rehearsalClient) Members(ctx context.Context, g groupRef) ([]member, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.fixture.Members(ctx, g)
}

func (c *rehearsalClient) Operations(ctx context.Context) ([]operation, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.fixture.Operations(ctx)
}

func (c *rehearsalClient) Operation(ctx context.Context, name string) (operation, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.fixture.Operation(ctx, name)
}

func (c *rehearsalClient) SetPoolSize(ctx context.Context, pool string, size int32) (string, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.fixture.now = time.Now().UTC()
	restoring := c.firstNode != "" && c.fixture.groups[0].target == 0 && size == 1
	name, err := c.fixture.SetPoolSize(ctx, pool, size)
	if err == nil && restoring {
		// Reuse the name freed by AddFirst for the new VM created by RemoveFirst.
		c.fixture.groups[0].members[0].Name = c.firstNode
		c.fixture.deleted = slices.DeleteFunc(c.fixture.deleted, func(deleted string) bool {
			return deleted == c.firstNode
		})
	}
	if err != nil || c.path == "" {
		return name, err
	}
	if restoring {
		c.snapshot.Calls++
	}
	if err := c.save(); err != nil {
		return "", err
	}
	// With REHEARSAL_LOSE=resize the first resize that sets a size back
	// is applied and its answer never returns.
	if restoring && c.snapshot.Calls == 1 && os.Getenv("REHEARSAL_LOSE") == "resize" {
		<-ctx.Done()
		return "", ctx.Err()
	}
	return name, nil
}

func (c *rehearsalClient) DeleteInstances(ctx context.Context, g groupRef, names []string, requestID string) error {
	c.mu.Lock()
	defer c.mu.Unlock()
	if err := c.fixture.DeleteInstances(ctx, g, names, requestID); err != nil {
		return err
	}
	return c.save()
}

func (c *rehearsalClient) Permissions(ctx context.Context, permissions []string) ([]string, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.fixture.Permissions(ctx, permissions)
}
