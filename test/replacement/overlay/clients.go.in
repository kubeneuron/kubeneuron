package aws

import (
	"context"
	"os"

	"github.com/kubeneuron/kubeneuron/pkg/cloud"
	"github.com/kubeneuron/kubeneuron/test/replacement/simaws"
)

func newManagedProvider(_ context.Context, options cloud.Config) (*managedProvider, error) {
	cluster := options.Options["cluster"]
	newClients := simaws.NewClients
	if cluster == "training-two-zones" {
		newClients = simaws.NewTwoZoneClients
	}
	ec, scaling, eks := newClients(cluster)
	if path := os.Getenv("REHEARSAL_DELETE_SNAPSHOT"); path != "" {
		if err := ec.EnableLostResponse(path); err != nil {
			return nil, err
		}
	}
	return &managedProvider{
		Recycler:   NewWithAPI(ec),
		updater:    eks,
		terminator: scaling,
		repairReader: &repairReader{
			cluster:              cluster,
			checkAutoscalerGroup: options.CheckAutoscalerGroup,
			ec2:                  ec,
			scaling:              scaling,
			eks:                  eks,
			updates:              &updateCache{},
		},
	}, nil
}
