{
  "title": "KubeNeuron / Health & Errors",
  "uid": "kubeneuron-health-errors",
  "description": "generated by `make generate-gpucatalog` from internal/gpucatalog; do not edit. What is broken, where, and since when? ECC, retired-page and row-remap signals come from the canonical catalog. XID is shown from KubeNeuron incidents (class xid-*), not from a DCGM-derived XID rate, which the catalog does not record.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "kubeneuron",
    "gpu",
    "health"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node_pool",
        "label": "node_pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_model",
        "label": "gpu_model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_uuid",
        "label": "gpu_uuid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "ECC uncorrectable errors/s",
      "type": "timeseries",
      "description": "Derived double-bit ECC error rate per device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid) (kubeneuron_gpu_ecc_uncorrectable_errors_per_second{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "ECC corrected errors/s",
      "type": "timeseries",
      "description": "Derived single-bit ECC error rate per device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid) (kubeneuron_gpu_ecc_corrected_errors_per_second{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Retired pages/s",
      "type": "timeseries",
      "description": "Derived retired-page rate per device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid) (kubeneuron_gpu_retired_pages_per_second{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memory hard fault active",
      "type": "state-timeline",
      "description": "Derived hard-fault indicator (volatile/aggregate double-bit ECC, uncorrectable remaps, remap failed/pending, retired pages pending, unrepairable memory), by component.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid, component) (kubeneuron_gpu_memory_hard_fault_active{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{node}} {{gpu_uuid}} {{component}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Row remap failed / pending",
      "type": "timeseries",
      "description": "Canonical row-remap flags per device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid) (kubeneuron_gpu_row_remap_failed{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "failed {{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid) (kubeneuron_gpu_row_remap_pending{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "pending {{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "XID incidents opened (from KubeNeuron incidents, not a DCGM XID rate)",
      "type": "timeseries",
      "description": "Incidents the agent opened from kmsg/DCGM XID observations, by class. The catalog records no XID event counter, so no XID rate is derived.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (class) (increase(kubeneuron_incidents_opened_total{cluster=~\"$cluster\",class=~\"xid-.*\"}[1h]))",
          "legendFormat": "{{class}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "NVLink / PCIe errors",
      "type": "timeseries",
      "description": "Derived NVLink error and PCIe replay rates per device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid) (kubeneuron_gpu_nvlink_errors_per_second{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "nvlink {{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid) (kubeneuron_gpu_pcie_replays_per_second{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "pcie {{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    }
  ]
}
