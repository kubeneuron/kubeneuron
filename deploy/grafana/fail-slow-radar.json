{
  "title": "KubeNeuron / Fail-slow Radar",
  "uid": "kubeneuron-fail-slow-radar",
  "description": "generated by `make generate-gpucatalog` from internal/gpucatalog; do not edit. Which GPUs are quietly slower than their peers? Experimental and shadow-only: the peer score triggers nothing, and the shadow alerts go to humans, never to the controller. A device with no sample is not scored, not healthy.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "kubeneuron",
    "gpu",
    "fail-slow",
    "shadow"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node_pool",
        "label": "node_pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_model",
        "label": "gpu_model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_uuid",
        "label": "gpu_uuid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Suspect devices (shadow alerts firing)",
      "type": "stat",
      "description": "Count of firing shadow alerts in the selection.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ALERTS{gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",kubeneuron_shadow=\"true\",alertstate=\"firing\"})",
          "legendFormat": "firing",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Devices with a peer score",
      "type": "stat",
      "description": "Devices whose fail-slow peer score has a sample (all three gates hold).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(kubeneuron_gpu_fail_slow_score_ratio{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "scored",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Worst peer score",
      "type": "stat",
      "description": "Largest fail-slow peer score in the selection.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(kubeneuron_gpu_fail_slow_score_ratio{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "max",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Fail-slow peer score by device",
      "type": "timeseries",
      "description": "1 - own SM clock ratio / gpu_model peer median; present only while the device is also throttled and has at least 3 peers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kubeneuron_gpu_fail_slow_score_ratio{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"}",
          "legendFormat": "{{node}} {{gpu_uuid}} ({{gpu_model}})",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Shadow alerts",
      "type": "state-timeline",
      "description": "vmalert ALERTS state for shadow rules (kubeneuron_shadow=\"true\"), by alert name and device.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (alertname, alertstate, node, gpu_uuid) (ALERTS{gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",kubeneuron_shadow=\"true\"})",
          "legendFormat": "{{alertname}} {{alertstate}} {{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "SM clock ratio by device",
      "type": "timeseries",
      "description": "Derived SM clock / max clock; the peer score's input.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid) (kubeneuron_gpu_clock_ratio{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\",domain=\"sm\"})",
          "legendFormat": "{{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Throttle share by reason",
      "type": "timeseries",
      "description": "Derived share of time throttled over 5m, by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (node, gpu_uuid, reason) (kubeneuron_gpu_throttle_share_ratio{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{reason}} {{node}} {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    }
  ]
}
