{
  "title": "KubeNeuron / Fleet Reliability Overview",
  "uid": "kubeneuron-fleet-overview",
  "description": "generated by `make generate-gpucatalog` from internal/gpucatalog; do not edit. Is the fleet healthy, how much capacity is at risk and how much was returned? Reads canonical GPU series and KubeNeuron control-plane counters; a missing series renders as No data, never as zero.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "kubeneuron",
    "gpu",
    "fleet"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node_pool",
        "label": "node_pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_model",
        "label": "gpu_model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_uuid",
        "label": "gpu_uuid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "GPUs reporting",
      "type": "stat",
      "description": "Devices with a GPU temperature sample (T0, reported by every supported device) in the selection. kubeneuron_gpu_present is deferred and never recorded, so a GPU that exists but reports nothing is not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(kubeneuron_gpu_temperature_celsius{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "reporting",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "GPUs under incident",
      "type": "stat",
      "description": "kubeneuron_degraded_gpus summed over class and owner. Absent on a standby replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kubeneuron_degraded_gpus{cluster=~\"$cluster\"})",
          "legendFormat": "degraded",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Capacity returned to service (24h)",
      "type": "stat",
      "description": "GPU-hours recovered from resolved incidents over the last day.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(kubeneuron_gpu_recovered_capacity_hours_total{cluster=~\"$cluster\"}[24h]))",
          "legendFormat": "recovered",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mean GPU utilization",
      "type": "stat",
      "description": "Average SM utilization ratio across the selection.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg(kubeneuron_gpu_utilization_ratio{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "utilization",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Degraded GPUs by class",
      "type": "timeseries",
      "description": "Accelerators under a non-terminal incident, by problem class.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (class) (kubeneuron_degraded_gpus{cluster=~\"$cluster\"})",
          "legendFormat": "{{class}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recovered capacity by class",
      "type": "timeseries",
      "description": "Cumulative GPU-hours returned to service from resolved incidents.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (class) (kubeneuron_gpu_recovered_capacity_hours_total{cluster=~\"$cluster\"})",
          "legendFormat": "{{class}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Power draw by model",
      "type": "timeseries",
      "description": "Board power summed per gpu_model.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (gpu_model) (kubeneuron_gpu_power_watts{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{gpu_model}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Utilization by model",
      "type": "timeseries",
      "description": "Mean SM utilization per gpu_model.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "avg by (gpu_model) (kubeneuron_gpu_utilization_ratio{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "{{gpu_model}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    }
  ]
}
