{
  "title": "KubeNeuron / Remediation & Recovered Capacity",
  "uid": "kubeneuron-remediation",
  "description": "generated by `make generate-gpucatalog` from internal/gpucatalog; do not edit. What did KubeNeuron do, did it work, and what came back? Control-plane counters plus the shadow alert panel; the legacy kubeneuron-dashboard.json keeps its own copies of the incident panels.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "kubeneuron",
    "remediation"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node_pool",
        "label": "node_pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_model",
        "label": "gpu_model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_uuid",
        "label": "gpu_uuid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Incidents opened (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(kubeneuron_incidents_opened_total{cluster=~\"$cluster\"}[1h]))",
          "legendFormat": "opened",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Incidents recovered (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(kubeneuron_incidents_recovered_total{cluster=~\"$cluster\"}[1h]))",
          "legendFormat": "recovered",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Actions pending",
      "type": "stat",
      "description": "Dispatched agent actions not yet claimed; sustained non-zero means an unreachable agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kubeneuron_actions_pending{cluster=~\"$cluster\"})",
          "legendFormat": "pending",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Capacity returned (24h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(kubeneuron_gpu_recovered_capacity_hours_total{cluster=~\"$cluster\"}[24h]))",
          "legendFormat": "recovered",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Incidents by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (state) (kubeneuron_incidents{cluster=~\"$cluster\"})",
          "legendFormat": "{{state}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Playbook steps by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (rate(kubeneuron_steps_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recovered vs needed a human",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (class, unattended) (increase(kubeneuron_incidents_recovered_total{cluster=~\"$cluster\"}[1h]))",
          "legendFormat": "{{class}} unattended={{unattended}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Gate denials and deferred destructive steps",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(kubeneuron_gate_denials_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "denied",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (reason) (rate(kubeneuron_destructive_steps_deferred_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "deferred {{reason}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 9,
      "title": "Device topology classifications",
      "type": "timeseries",
      "description": "Device topology classifications (topology-classification/v1) by topology and whether device-scoped actions were eligible or refused. Every non-whole-device topology refuses; which node was classified how is on the node's readiness page, not in a series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (topology, result) (rate(kubeneuron_topology_classifications_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{topology}} {{result}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 10,
      "title": "Checkpoint advisories and group peer requests",
      "type": "timeseries",
      "description": "Advisory notices stamped on opted-in Pods when an incident parked for approval with a drain or eviction still downstream, by outcome (stamped and unreachable per workload, withdrawn per notice, skipped per round that sent nothing), and checkpoint requests sent to group peers the disruption itself does not touch, by the Phase 1 outcome plus skipped. Which Pods were involved is on the incident's audit trail.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (rate(kubeneuron_checkpoint_advisories_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "advisory {{outcome}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (rate(kubeneuron_checkpoint_group_requests_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "group peer {{outcome}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 11,
      "title": "Impact previews and approval binding",
      "type": "timeseries",
      "description": "Impact previews computed at approval park by result, and approval decisions by what they were bound to (round, round_and_impact, none). An unavailable preview or a decision bound to nothing is worth a look.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (result) (rate(kubeneuron_impact_previews_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "preview {{result}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (binding) (rate(kubeneuron_approvals_bound_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "approval {{binding}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 12,
      "title": "Impact preview duration",
      "type": "timeseries",
      "description": "p50 and p90 of kubeneuron_impact_preview_seconds. A p90 near the policy budget means the listing or topology read is slow enough to start producing unavailable previews.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kubeneuron_impact_preview_seconds_bucket{cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(kubeneuron_impact_preview_seconds_bucket{cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "p90",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 13,
      "title": "Shadow alerts (would have fired)",
      "type": "table",
      "description": "vmalert ALERTS carrying kubeneuron_shadow=\"true\". These rules route to humans only and drive no remediation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "ALERTS{gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",kubeneuron_shadow=\"true\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    }
  ]
}
