          "legendFormat": "gpu {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (gpu_uuid) (kubeneuron_gpu_memory_thermal_headroom_celsius{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "memory {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Power",
