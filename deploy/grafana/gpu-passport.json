{
  "title": "KubeNeuron / GPU Passport",
  "uid": "kubeneuron-gpu-passport",
  "description": "generated by `make generate-gpucatalog` from internal/gpucatalog; do not edit. The full history of one GPU: pick a gpu_uuid. Every panel reads canonical or derived catalog series; a field the device does not report is No data.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "kubeneuron",
    "gpu",
    "passport"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, cluster)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node_pool",
        "label": "node_pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node_pool)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_model",
        "label": "gpu_model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, node)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "gpu_uuid",
        "label": "gpu_uuid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_temperature_celsius, gpu_uuid)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(kubeneuron_gpu_utilization_ratio, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (gpu_uuid) (kubeneuron_gpu_temperature_celsius{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "gpu {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (gpu_uuid) (kubeneuron_gpu_memory_temperature_celsius{cluster=~\"$cluster\",node_pool=~\"$node_pool\",gpu_model=~\"$gpu_model\",node=~\"$node\",gpu_uuid=~\"$gpu_uuid\",namespace=~\"$namespace\",pod=~\"$pod\"})",
          "legendFormat": "memory {{gpu_uuid}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Thermal headroom",
      "type": "timeseries",
      "description": "Derived margin to the slowdown threshold for the die and the memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
