# Binaries
/bin/
/dist/

# mkdocs output
/site/

# Go
*.test
*.out
coverage.html

# Local state
*.db
*.db-wal
*.db-shm

# Web
# web/dist/index.html (panel v1) is committed and embedded via web/embed.go;
# ignore only dependency/build byproducts.
web/node_modules/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local env
.env
.env.local
# `go build ./cmd/<name>` drops the binary at the repository root. One
# (kubeneuronctl, 16 MB) was committed by accident in the v0.8 cycle; name
# all of them so it cannot happen again.
/kubeneuron-agent
/kubeneuron-controller
/kubeneuron-operator
/kubeneuronctl
/sentinel-operator

# Agent worktrees and local session scratch
.claude/

# The lock make verify-generate serialises on.
.make-generate.lock
